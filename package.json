{
  "name": "web-liquid-glass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web port of the AndroidLiquidGlass (Kyant0/AndroidLiquidGlass) Liquid Glass demo — Vue 3 + TypeScript + Vite, blur and refraction on native browser filters only (`backdrop-filter` + an SVG `feDisplacementMap` chain), zero WebGL.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:userscript": "node scripts/check-userscript.mjs",
    "stage:userscript": "node scripts/stamp-userscript.mjs 0 dist/liquid-glass-refract.user.js",
    "probe:map": "node scripts/refraction-probe.mjs map",
    "probe:render": "node scripts/refraction-probe.mjs render",
    "probe:band": "node scripts/refraction-probe.mjs band",
    "probe:perf": "node scripts/refraction-probe.mjs perf",
    "probe:fidelity": "node scripts/refraction-probe.mjs fidelity",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.12"
  }
}
